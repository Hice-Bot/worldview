# Server-side environment variables (Express proxy)
# These keys are NEVER exposed to the browser

PORT=3001

# OpenSky Network credentials for WebSocket flight subscriptions
# Register at: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Transport for NSW CCTV cameras
# Register at: https://opendata.transport.nsw.gov.au/
NSW_TRANSPORT_API_KEY=

# AISStream.io for real-time ship/vessel tracking
# Register at: https://aisstream.io/
AISSTREAM_API_KEY=
