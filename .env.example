# Client-side environment variables (loaded by Vite)
# Only VITE_ prefixed variables are exposed to the browser

# Google Maps Platform API key for Photorealistic 3D Tiles
# Get one at: https://console.cloud.google.com/google/maps-platform
# Falls back to OpenStreetMap if not set
VITE_GOOGLE_API_KEY=

# Cesium Ion access token for terrain/imagery services
# Get one at: https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=
